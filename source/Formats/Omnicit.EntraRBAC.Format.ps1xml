    <View>
      <Name>Omnicit.EntraRBAC.StructureValidation</Name>
      <ViewSelectedBy>
        <TypeName>Omnicit.EntraRBAC.StructureValidation</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>Valid</PropertyName></ListItem>
              <ListItem>
                <Label>Errors</Label>
                <ScriptBlock>($_.Errors | ForEach-Object { '[{0}] {1}: {2}' -f $_.Severity, $_.Path, $_.Message }) -join [Environment]::NewLine</ScriptBlock>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>Omnicit.EntraRBAC.RequiredScope</Name>
      <ViewSelectedBy>
        <TypeName>Omnicit.EntraRBAC.RequiredScope</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Cmdlet</Label><Width>38</Width></TableColumnHeader>
          <TableColumnHeader><Label>Transport</Label><Width>11</Width></TableColumnHeader>
          <TableColumnHeader><Label>GraphScope</Label></TableColumnHeader>
          <TableColumnHeader><Label>AzureRole</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap />
            <TableColumnItems>
              <TableColumnItem><PropertyName>Cmdlet</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Transport</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>@($_.GraphScope) -join ', '</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>@($_.AzureRole) -join ', '</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
