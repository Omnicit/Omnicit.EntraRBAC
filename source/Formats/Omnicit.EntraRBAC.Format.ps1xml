<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>Omnicit.EntraRBAC.Inventory</Name>
      <ViewSelectedBy>
        <TypeName>Omnicit.EntraRBAC.Inventory</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Version</Label></TableColumnHeader>
          <TableColumnHeader><Label>Groups</Label></TableColumnHeader>
          <TableColumnHeader><Label>AdminUnits</Label></TableColumnHeader>
          <TableColumnHeader><Label>Catalogs</Label></TableColumnHeader>
          <TableColumnHeader><Label>AccessPackages</Label></TableColumnHeader>
          <TableColumnHeader><Label>AccessReviews</Label></TableColumnHeader>
          <TableColumnHeader><Label>RoleAssignments</Label></TableColumnHeader>
          <TableColumnHeader><Label>RoleMgmtPolicies</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Version</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>@($_.Groups).Count</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>@($_.AdministrativeUnits).Count</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>@($_.Catalogs).Count</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>@($_.AccessPackages).Count</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>@($_.AccessReviews).Count</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>@($_.RoleAssignments).Count</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>@($_.RoleManagementPolicies).Count</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
