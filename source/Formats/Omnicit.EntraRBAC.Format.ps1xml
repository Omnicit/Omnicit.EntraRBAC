              <ListItem><Label>GraphScope</Label><ScriptBlock>@($_.GraphScope) -join [System.Environment]::NewLine</ScriptBlock></ListItem>
              <ListItem><Label>AzureRole</Label><ScriptBlock>@($_.AzureRole) -join [System.Environment]::NewLine</ScriptBlock></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
